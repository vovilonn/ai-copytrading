# ── Секреты ─────────────────────────────────────────────────────────────────
# .env держит СРАЗУ ВСЁ: строку сессии Telegram (равносильна полному доступу к аккаунту),
# ключи Bybit, JWT_SECRET, ENCRYPTION_KEY, пароль админки. Ни один вариант файла — включая
# .env.prod/.env.local — в репозиторий не идёт; шаблон без значений живёт в .env.example.
.env
.env.*
!.env.example

# OAuth-токены провайдеров: ai-proxy пишет их в .ai-proxy/auths, вендоренный CLIProxyAPI —
# в свой ./auths. Токен подписки Claude — такой же секрет, как пароль.
auths/*.json
**/auths/*.json

# Ключи и сертификаты, если кто-то положит их рядом с кодом.
*.pem
*.key
*.p12
id_rsa*

# Бэкапы репозитория и базы: содержат и секреты, и приватные данные каналов.
*.bundle
*.sql.gz

# ── Локальное состояние и артефакты ─────────────────────────────────────────
node_modules/
dist/
temp/

# Скачанные медиа тг-ингеста (фото/превью видео) и отчёты e2e-прогонов — бинарь и рабочие
# данные, в репозиторий не идут.
var/

# Runtime-состояние ai-proxy: OAuth-токены Claude и логи.
.ai-proxy/

# Рабочие файлы subagent-driven-development
.superpowers/

# Локальные оверрайды compose на конкретном сервере (адреса, порты, пути этого хоста).
docker-compose.override.yml
