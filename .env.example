# Скопируйте в .env: cp .env.example .env

# ── ai-proxy ────────────────────────────────────────────────────────────────
# Пароль management API прокси. Без него /v0/management/* не поднимается,
# а значит не отработает и pnpm ai-proxy:login. Сгенерировать: openssl rand -hex 24
AI_PROXY_MANAGEMENT_KEY=

# Базовый URL прокси для бэкенда. Из контейнера — http://ai-proxy:8317
AI_PROXY_URL=http://127.0.0.1:8317

# Явный opt-in для ЖИВЫХ AI-тестов engine (ai-client.test.ts/ai-golden.test.ts/
# pipeline-ai.e2e.test.ts) — жгут платный ai-proxy (golden — до 30 вызовов за прогон). По
# умолчанию (не задан) эти тесты SKIPPED, даже если локальный ai-proxy поднят. 1 — включить.
AI_LIVE_TESTS=

# Таймзона контейнеров.
TZ=Etc/UTC

# ── Telegram (MTProto userbot) ──────────────────────────────────────────────
# api_id / api_hash берутся на https://my.telegram.org
TG_APP_API_ID=
TG_APP_API_HASH=
# Создаётся скриптом `pnpm tg:login`. Равносильна полному доступу к аккаунту.
TG_SESSION=

# ── ТЕСТОВЫЙ РЕЖИМ: свои каналы вместо боевых ───────────────────────────────
# Боевые каналы постят 2-8 сообщений в день — ждать живой сигнал ради проверки бота бессмысленно.
# Этот оверрайд подставляет ВАШИ каналы, куда вы сами пишете сигналы. Весь путь остаётся настоящим:
# Telegram → разбор → риск → реальный ордер на бирже (на demo-сети).
#
# Формат: <номер боевого канала>=<id вашего канала>[:<id топика>], через запятую.
#   1 → ch1-structured (СТРУКТУРНЫЕ сигналы, regex-парсер: «#SOL/USDT LONG / Диапазон входа / TP / SL»)
#   2 → ch2-freeform   (СВОБОДНЫЙ текст, разбирает AI: «беру соль от 76, стоп 72, цели 80 и 83»)
#
# Как получить id своего канала:  pnpm tg:chats   (покажет все каналы аккаунта юзербота с их id)
# Требование: аккаунт юзербота должен быть УЧАСТНИКОМ канала. id — «сырой», БЕЗ префикса -100.
#
# Примеры:
#   TG_CHANNEL_OVERRIDES=1=2999999999                    # подменить только структурный канал
#   TG_CHANNEL_OVERRIDES=1=2999999999,2=2888888888       # оба канала
#   TG_CHANNEL_OVERRIDES=2=2888888888:173666             # если ваш источник — топик форума
#
# ⚠️ Пока оверрайд включён, БОЕВЫЕ каналы НЕ слушаются (иначе живой сигнал открыл бы реальную
#    сделку посреди теста). Пусто = боевой режим.
TG_CHANNEL_OVERRIDES=

# ── E2E-петля (apps/e2e, `pnpm e2e`) ────────────────────────────────────────
# Отдельная сессия Telegram для ПОСТЕРА e2e — тот же аккаунт, но свой auth-key.
# Зачем: два процесса на ОДНОЙ строке сессии дерутся за обновления — пока постер подключён,
# tg-ingest перестаёт получать realtime и пост доезжает только бэкфиллом (или после рестарта).
# Заводится одной командой, SMS не требуется (тот же обмен, что вход по QR в Telegram Desktop:
# новый клиент просит login-token, а уже авторизованная TG_SESSION его принимает):
#   pnpm e2e session
E2E_TG_SESSION=
# Облачный пароль (2FA) аккаунта — нужен ТОЛЬКО в момент `pnpm e2e session`, если 2FA включена.
E2E_TG_2FA_PASSWORD=

# ── Bybit ───────────────────────────────────────────────────────────────────
# Мастер-ключ. Из него провижинятся субаккаунты каналов (`pnpm bybit:setup`).
BYBIT_API_KEY=
BYBIT_API_SECRET=
# testnet | demo | mainnet
# demo — Bybit DEMO TRADING (api-demo.bybit.com): testnet блокирует order/create regulatory-кодом
# 10024 (не наш регион) — demo торгует реальными рыночными ценами виртуальным балансом, ордера
# проходят. У demo НЕТ собственного публичного WS — market-data/tickers-feed.ts на demo слушает
# mainnet public WS (demo торгует по тем же реальным ценам).
BYBIT_NETWORK=testnet
# Гейт staleness/slippage перед market-входом (engine/src/pipeline.ts): если живой mark ушёл от
# сигнальной цены входа больше чем на этот процент — вход пропускается (skipped price_slippage).
# Дефолт 0.5, если не задано. Применяется только в EXECUTION_MODE=live (нет сети в dry_run).
MAX_ENTRY_SLIPPAGE_PCT=0.5

# ── Postgres ────────────────────────────────────────────────────────────────
POSTGRES_USER=copytrade
POSTGRES_PASSWORD=
POSTGRES_DB=copytrade
# 5432 на хосте часто занят postgres другого проекта.
POSTGRES_PORT=5442
DATABASE_URL=postgresql://copytrade:@127.0.0.1:5442/copytrade
# Тесты (pnpm test) работают в отдельной базе на том же сервере — не трогают dev-данные.
TEST_DATABASE_NAME=copytrade_test

# ── Админка ─────────────────────────────────────────────────────────────────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# Не короче 32 символов: openssl rand -hex 32
JWT_SECRET=
# Шифрование ключей субаккаунтов в БД: openssl rand -hex 32
ENCRYPTION_KEY=

# ── Режим исполнения ────────────────────────────────────────────────────────
# dry_run: всё парсится и пишется в БД, но ордера на биржу не уходят.
EXECUTION_MODE=dry_run

# ── Медиа ───────────────────────────────────────────────────────────────────
# Абсолютный путь к каталогу, куда tg-ingest пишет фото (их читают engine для AI-промпта и api для
# раздачи в UI). Пустой — для локальной разработки: корень ищется вверх от cwd по pnpm-workspace.yaml.
# В docker-compose задан явно (/app/var/media), потому что прод-образ сплющивает apps/<name>/src → src
# и вычислять корень «на N уровней вверх от файла» там нельзя. Обычно менять не нужно.
MEDIA_ROOT=
