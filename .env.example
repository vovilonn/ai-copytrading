# Скопируйте в .env: cp .env.example .env

# Пароль management API прокси (ai-proxy). Без него /v0/management/* не поднимается,
# а значит не отработает и pnpm ai-proxy:login. Сгенерировать: openssl rand -hex 24
AI_PROXY_MANAGEMENT_KEY=

# Таймзона контейнера ai-proxy.
TZ=Etc/UTC

TG_APP_API_ID=
TG_APP_API_HASH=

BYBIT_API_KEY=
BYBIT_API_SECRET=