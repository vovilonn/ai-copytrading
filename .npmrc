# Явно фиксируем настройку, под которой уже выложен pnpm-lock.yaml (settings.injectWorkspacePackages:
# true) — на этой машине она стоит глобально (~/Library/Preferences/pnpm/rc), поэтому `pnpm install
# --frozen-lockfile` на хосте молча работает, а в чистом Docker-контейнере (нет глобального rc)
# ловит ERR_PNPM_LOCKFILE_CONFIG_MISMATCH. Кладём настройку в репозиторий, чтобы сборка не зависела
# от конфигурации конкретной машины (найдено при реализации задачи 13).
inject-workspace-packages=true
